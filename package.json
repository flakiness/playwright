{
  "name": "@flakiness/playwright",
  "version": "1.18.0",
  "packageManager": "pnpm@11.5.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flakiness/playwright.git"
  },
  "exports": {
    ".": {
      "types": "./types/src/playwright-test.d.ts",
      "import": "./lib/playwright-test.js",
      "require": "./lib/playwright-test.js"
    }
  },
  "bin": {
    "flakiness-playwright-timings": "./lib/flakiness-playwright-timings.js"
  },
  "type": "module",
  "description": "A custom Playwright test reporter that generates Flakiness Reports from your Playwright test runs",
  "types": "./types/src/playwright-test.d.ts",
  "scripts": {
    "build": "kubik build.mts",
    "watch": "kubik build.mts -w",
    "test": "playwright test"
  },
  "keywords": [
    "playwright",
    "test",
    "reporter",
    "flakiness",
    "testing",
    "e2e",
    "test-reporting"
  ],
  "author": "Degu Labs, Inc",
  "license": "MIT",
  "engines": {
    "node": ">=22.9.0"
  },
  "devDependencies": {
    "@flakiness/flakiness-report": "^0.36.0",
    "@flakiness/playwright": "^1.18.0",
    "@flakiness/sdk": "^3.6.0",
    "@playwright/test": "1.62.0",
    "@types/node": "^25.9.5",
    "esbuild": "^0.28.1",
    "kubik": "^0.24.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
